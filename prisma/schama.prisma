generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model Cliente {
  id       Int    @id @default(autoincrement())
  nome     String
  cpf      String @unique
  email    String @unique
  senha    String
  telefone String

  criadoEm DateTime @default(now())

  @@map("clientes")
}