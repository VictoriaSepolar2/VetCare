generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cliente {
  id       Int      @id @default(autoincrement())
  nome     String
  cpf      String   @unique
  email    String   @unique
  telefone String
  criadoEm    DateTime @default(now())
  criadoPorId Int?
  criadoPor   Usuario? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  pets        Pet[]

  @@index([criadoPorId])

  @@map("clientes")
}

model Pet {
  id             Int        @id @default(autoincrement())
  clienteId      Int
  nome           String
  especie        String
  raca           String
  dataNascimento DateTime

  consultas Consulta[]
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  @@map("pets")
}

model Veterinario {
  id            Int    @id @default(autoincrement())
  nome          String
  crmv          String @unique
  especialidade String
  email         String @unique

  consultas Consulta[]

  @@map("veterinarios")
}

model Consulta {
  id             Int      @id @default(autoincrement())
  petId          Int
  veterinarioId  Int
  dataConsulta   DateTime
  statusConsulta String   @default("Agendada")

  veterinario Veterinario @relation(fields: [veterinarioId], references: [id])
  pet         Pet         @relation(fields: [petId], references: [id])
  prontuario  Prontuario?

  @@map("consultas")
}

model Prontuario {
  id                     Int       @id @default(autoincrement())
  consultaId             Int       @unique
  diagnostico            String
  medicamentosPrescritos String
  dataRetorno            DateTime?

  consulta Consulta @relation(fields: [consultaId], references: [id])

  @@map("prontuarios")
}

model Usuario {
  id         Int      @id @default(autoincrement())
  nome       String
  usuario    String   @unique
  email      String   @unique
  senha      String
  criadoEm        DateTime  @default(now())
  clientesCriados Cliente[]

  @@map("usuarios")
}