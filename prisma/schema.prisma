generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Cliente {
  id       Int    @id @default(autoincrement())
  nome     String
  cpf      String @unique
  email    String @unique
  telefone String
  criadoEm DateTime @default(now())

  pets Pet[]

  @@map("clientes")
}

model Pet {
  id             Int      @id @default(autoincrement())
  clienteId      Int
  cliente        Cliente  @relation(fields: [clienteId], references: [id])
  nome           String
  especie        String
  raca           String
  dataNascimento DateTime

  consultas Consulta[]

  @@map("pets")
}

model Veterinario {
  id           Int    @id @default(autoincrement())
  nome         String
  crmv         String @unique
  especialidade String
  email        String @unique

  consultas Consulta[]

  @@map("veterinarios")
}

model Consulta {
  id            Int    @id @default(autoincrement())
  petId         Int
  veterinarioId Int

  pet           Pet         @relation(fields: [petId], references: [id])
  veterinario   Veterinario @relation(fields: [veterinarioId], references: [id])

  dataConsulta  DateTime
  statusConsulta String @default("Agendada")

  prontuario Prontuario?

  @@map("consultas")
}

model Prontuario {
  id                      Int       @id @default(autoincrement())
  consultaId              Int       @unique
  consulta                Consulta  @relation(fields: [consultaId], references: [id])

  diagnostico             String
  medicamentosPrescritos  String
  dataRetorno             DateTime?

  @@map("prontuarios")
}

model Usuario {
  id          Int                @id @default(autoincrement())
  usuario     String             @unique
  senha       String
  tipo        String
  criadoEm    DateTime           @default(now())

  permissoes  PermissaoUsuario[]

  @@map("usuarios")
}

model PermissaoUsuario {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  permissao   String

  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, permissao])
  @@map("permissoes_usuarios")
}